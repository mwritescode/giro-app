{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "giro",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "giro"
    }
  ],
  "routes": [
    {
      "pattern": "giro.mwritescode.dev",
      "custom_domain": true
    }
  ],
  "vars": {
    "APP_URL": "https://giro.mwritescode.dev",
    "RESEND_FROM": "Giro <giro@mwritescode.dev>"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "giro",
      "database_id": "4b88f654-09b3-484e-841b-b2b2547da752"
    }
  ]
}
